{
  "name": "@webship.co/workspace-wekan",
  "version": "1.0.3",
  "description": "Wekan for Webship Workspace: the builder (`cmd-wekan-project.sh`, a site of the open-source kanban board, from Wekan's own image on the project's own MongoDB 7, in containers: DDEV, with the default accounts in their roles of a sample board and its cards in the board's lists) and its tool in every sites folder, the Wekan step pack wired into the testing setup, the cards of a Wekan board as work items of the tracker family (list, read, analyze, and do the work with the workspace's AI CLI on a branch; comments, moves to another list, archiving, labels and assignees after a person's click, writes off by default), and its AI items in their folders.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-wekan.git"
  },
  "workspacePlugin": {
    "name": "wekan",
    "label": "Wekan",
    "summary": "A builder for Wekan sites with a sample board on MongoDB 7; its cards as work items",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "typeActions": {
      "wekan": [
        "sites",
        "code"
      ]
    },
    "settingsFile": "plugin.wekan.settings.yml",
    "settingsTemplate": "config/plugin.wekan.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-wekan-project.sh",
        "commands/cmd-tools-wekan-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-wekan.sh"
      ],
      "args": [
        "scripts/args/arg-wekan.sh",
        "scripts/args/arg-wekan-cli.sh"
      ],
      "machine": [
        "scripts/docker-compose.wekan.yaml",
        "scripts/wekan-site.mjs",
        "scripts/wekan-serve.sh",
        "scripts/wekan-proxy.conf",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/wekan-site-builder.md",
        "ai/agents/wekan-tester.md",
        "ai/agents/wekan-issue-worker.md"
      ],
      "skills": [
        "ai/skills/wekan-scenarios"
      ],
      "commands": [
        "ai/commands/wekan-test.md"
      ],
      "prompts": [
        "ai/prompts/wekan-build-and-test.md",
        "ai/prompts/wekan-issue-to-branch.md"
      ]
    },
    "features": [
      "features/wekan.feature",
      "features/wekan-runtimes.feature"
    ],
    "featuresSite": "cmd-wekan-project.sh ci-wekan --install --add-users --sample-content --runtime docker"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "dependencies": {
    "@webship.co/workspace-tracker": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
